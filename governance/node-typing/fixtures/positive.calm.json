    { "unique-id": "prod-vpc", "node-type": "network", "name": "Production VPC", "description": "Zone as network container (R5)" },
    { "unique-id": "core-ledger", "node-type": "onprem:mainframe", "name": "Core Ledger", "description": "On-prem mainframe (R7)", "metadata": [{ "hosting": "on-prem" }] }
