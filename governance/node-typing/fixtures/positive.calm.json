    { "unique-id": "waf", "node-type": "network", "name": "WAF", "description": "Routing/filtering only (R2)" },
    { "unique-id": "orders-api", "node-type": "service", "name": "Orders API", "description": "Runnable leaf unit (R1)" },
    { "unique-id": "orders-db", "node-type": "database", "name": "Orders DB", "description": "Running store (R3)" },
