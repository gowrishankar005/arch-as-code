    { "unique-id": "api-to-ledger", "relationship-type": { "connects": { "source": { "node": "orders-api" }, "destination": { "node": "core-ledger" } } }, "protocol": "TCP", "description": "R7: on-prem node participates in topology" },
    { "unique-id": "db-holds-pii", "relationship-type": { "composed-of": { "container": "orders-db", "nodes": ["customer-pii"] } }, "description": "R3: data-asset lives inside the database node" }
