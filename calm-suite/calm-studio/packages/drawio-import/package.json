{
  "name": "@calmstudio/drawio-import",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "echo \"no-op\" && exit 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@calmstudio/calm-core": "file:../calm-core",
    "@types/pako": "^2.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@xmldom/xmldom": "^0.9.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@finos/calm-models": "file:../../../../calm-models",
    "pako": "^2.1.0"
  }
}
