{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calm.finos.org/studio/patterns/strict-public-web.pattern.json",
  "title": "Strict Public Web Entry",
  "description": "The architecture's first node must be a webclient with unique-id 'public-web'. Most architectures will not satisfy this, so it showcases a json-schema violation, a node badge, and the Schema/Spectral source filter.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node",
          "properties": {
            "unique-id": { "const": "public-web" },
            "node-type": { "const": "webclient" }
          }
        }
      ]
    },
    "relationships": { "type": "array" }
  },
  "required": ["nodes"]
}
