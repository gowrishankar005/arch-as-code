{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calm.finos.org/studio/patterns/must-have-database.pattern.json",
  "title": "Must Have a Database",
  "description": "Requires the architecture to contain at least one node of node-type 'database'. Demonstrates a non-positional structural rule via JSON Schema 'contains'.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "node-type": { "const": "database" }
        },
        "required": ["node-type"]
      }
    },
    "relationships": { "type": "array" }
  },
  "required": ["nodes", "relationships"]
}
